//============================================================================
// FB "FB_Position_Trap_I" —— 油缸单方向位置定位(梯形速度曲线 + 末端积分精定位)
// 平台: SIMATIC S7-1200 / TIA Portal (SCL)   VERSION 1.0
//
// 【用途】油缸从当前位置推进到目标位置, 到达后停止。只做单方向(推进)。
//   兼顾"快"与"准":
//     - 快: 梯形速度曲线(满速推 -> 线性减速 -> 到位瞬间速度归零)
//     - 准: 末端小窗口内启用位置积分, 顶过阀死区/摩擦造成的静差
//
// 【为什么需要末端积分】速度环在末端输出很小, 若小于比例阀死区(约 3%),
//   阀不动 -> 油缸停在离目标还差零点几毫米的地方(静差)。末端积分会缓慢
//   累积, 把输出"顶"过阀死区, 把最后这点距离推到位。
//
// 【与纯速度规划的区别】本块在误差进入 I_Window(末端窗口)后, 在速度环输出
//   上叠加一个位置积分项, 用于消除静差; 误差进 Deadband 即停。
//
// 【速度环】目标速度 Vref 由距离规划得出, 再用
//     开度% = (Vref/Vmax)*100          (前馈)
//           + Kv*(Vref - Velocity)     (速度环修正)
//           + 末端位置积分项           (精定位, 只在末端窗口内)
//
// 【单方向要点】输出下限 = 0(不反向推)。目标位置必须 >= 当前实际位置。
//
// 【调用位置】循环中断 OB(如 OB35, 10ms), Cycle 填该 OB 实际周期
//============================================================================
FUNCTION_BLOCK "FB_Position_Trap_I"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0

VAR_INPUT
   Enable     : Bool;   // 使能; FALSE -> 输出 0
   Reset      : Bool;   // 复位
   Setpoint   : Real;   // 目标位置 [mm]
   Actual     : Real;   // 当前位置 [mm] (你已做好的位移采集)
   Velocity   : Real;   // 当前速度 [mm/s] (你已做好的速度采集)
   Vmax       : Real;   // 最大速度 [mm/s], 默认 140
   Accel      : Real;   // 减速度 [mm/s^2], 默认 200 (实测可调)
   Kv         : Real;   // 速度环增益 [%/(mm/s)], 默认 2.0
   Deadband   : Real;   // 到位死区 [mm], 默认 1.0
   Ti_p       : Real;   // 末端位置积分时间 [s], 默认 0.5 (越大积分越慢)
   I_Window   : Real;   // 末端积分激活窗口 [mm], 误差 <= 此值开始精定位, 默认 5.0
   Cycle      : Real;   // 采样周期 [s], 必须等于所在 OB 周期
END_VAR

VAR_OUTPUT
   Output     : Real;   // 阀开度指令 [0~100%] -> 接你已做好的电压输出
   InPosition : Bool;   // 到位标志
   VrefNow    : Real;   // 当前目标速度 [mm/s] (诊断)
   ErrNow     : Real;   // 当前误差 [mm] (诊断)
END_VAR

VAR
   I_Accum    : Real;   // 末端位置积分累加值 [%]
END_VAR

VAR_TEMP
   Err        : Real;   // 位置误差
   DecDist    : Real;   // 减速距离 = Vmax^2/(2a)
   Vref       : Real;   // 目标速度(规划值)
   OutFF      : Real;   // 速度前馈项
   OutCorr    : Real;   // 速度环修正项
   I_Term     : Real;   // 末端位置积分项
   Out_Raw    : Real;   // 求和未限幅值
END_VAR

BEGIN

//---------------------------------------------------------------------------
// REGION 1  使能 / 复位门控
//---------------------------------------------------------------------------
IF (NOT #Enable) OR #Reset THEN
    #Output     := 0.0;
    #InPosition := FALSE;
    #VrefNow    := 0.0;
    #ErrNow     := 0.0;
    #I_Accum    := 0.0;
    RETURN;
END_IF;

//---------------------------------------------------------------------------
// REGION 2  误差(单方向, 只推进)
//---------------------------------------------------------------------------
#Err    := #Setpoint - #Actual;
#ErrNow := #Err;

//---------------------------------------------------------------------------
// REGION 3  到位判断 —— 误差进死区 -> 停, 清积分
//---------------------------------------------------------------------------
IF #Err <= #Deadband THEN
    #InPosition := TRUE;
    #Output     := 0.0;
    #VrefNow    := 0.0;
    #I_Accum    := 0.0;
    RETURN;
END_IF;
#InPosition := FALSE;

//---------------------------------------------------------------------------
// REGION 4  梯形速度规划 —— 由剩余距离生成目标速度 Vref
//---------------------------------------------------------------------------
IF #Accel > 0.0 THEN
    #DecDist := (#Vmax * #Vmax) / (2.0 * #Accel);
ELSE
    #DecDist := 0.0;
END_IF;

IF #Err > #DecDist THEN
    #Vref := #Vmax;                       // 满速段
ELSE
    #Vref := SQRT(2.0 * #Accel * #Err);   // 减速段: v = sqrt(2*a*e)
    IF #Vref > #Vmax THEN
        #Vref := #Vmax;
    END_IF;
END_IF;
#VrefNow := #Vref;

//---------------------------------------------------------------------------
// REGION 5  速度环: 前馈 + 修正
//---------------------------------------------------------------------------
#OutFF   := (#Vref / #Vmax) * 100.0;
#OutCorr := #Kv * (#Vref - #Velocity);

//---------------------------------------------------------------------------
// REGION 6  末端位置积分(精定位) —— 只在末端窗口内激活
//   误差 <= I_Window 且 > Deadband 时累积; 窗口外不积(避免全程积分超调)
//   抗饱和: 总输出已满(>=100)且误差仍正 -> 冻结积分
//---------------------------------------------------------------------------
#I_Term := 0.0;

IF (#Err <= #I_Window) AND (#Err > #Deadband) AND (#Ti_p > 0.0) THEN
    #I_Term := #I_Accum + (#Kv * 0.1 * #Cycle / #Ti_p) * #Err;
    // 抗饱和: 若叠加后总输出超 100 且误差仍正, 回退本次累加
    IF (#OutFF + #OutCorr + #I_Term) > 100.0 AND #Err > 0.0 THEN
        #I_Term := #I_Accum;
    END_IF;
    #I_Accum := #I_Term;
ELSE
    #I_Accum := 0.0;    // 窗口外清积分, 防止残留
END_IF;

//---------------------------------------------------------------------------
// REGION 7  求和 + 单方向限幅 [0, 100]
//---------------------------------------------------------------------------
#Out_Raw := #OutFF + #OutCorr + #I_Term;

IF #Out_Raw > 100.0 THEN
    #Output := 100.0;
ELSIF #Out_Raw < 0.0 THEN
    #Output := 0.0;
ELSE
    #Output := #Out_Raw;
END_IF;

END_FUNCTION_BLOCK
