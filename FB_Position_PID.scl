//============================================================================
// FB "FB_Position_PID" —— 油缸单方向位置定位 PID
// 平台: SIMATIC S7-1200 / TIA Portal (SCL)   VERSION 1.0
//
// 【用途】油缸从当前位置推进到设定目标位置, 到达后停止推进。
//         只做单方向(推进), 不做反向。
//
// 【原理】输出% = Kp×误差 + I(抗饱和) − VelDamp×速度
//         误差大 -> 输出大 -> 速度快;  误差小 -> 减速;  进死区 -> 输出0 -> 停
//         阻尼项(-VelDamp×速度)解决"开度减小但速度降不下来"的惯性问题
//
// 【已由你完成的周边】(本 FB 不重复做, 只接收/输出对应信号):
//   1. 位移传感器采集 -> 换算成 mm, 接到 Actual 引脚
//   2. 油缸速度采集 -> mm/s, 接到 Velocity 引脚
//   3. PLC 电压输出 -> 放大板 -> 比例阀电流: 接到本 FB 的 Output 输出
//
// 【单方向要点】输出下限 = 0(不能反向推)。所以:
//   - 目标位置必须 >= 当前实际位置(只能往前推, 不能回拉)
//   - 若实际位置已超过目标(Err<0), 无法反向纠正, 只能停(输出0)
//   - 到位精度靠死区 Deadband + 阻尼 VelDamp 保证, 防止冲过头
//
// 【调用位置】循环中断 OB(如 OB35, 10ms), Cycle 填该 OB 实际周期
//============================================================================
FUNCTION_BLOCK "FB_Position_PID"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0

VAR_INPUT
   Enable     : Bool;   // 使能; FALSE -> 输出 0
   Reset      : Bool;   // 复位; TRUE -> 清积分
   Setpoint   : Real;   // 目标位置 [mm]
   Actual     : Real;   // 当前位置 [mm] (你已做好的位移采集)
   Velocity   : Real;   // 当前速度 [mm/s] (你已做好的速度采集)
   Kp         : Real;   // 比例增益 [%/mm]
   Ti         : Real;   // 积分时间 [s], 0 = 禁用积分
   VelDamp    : Real;   // 速度阻尼 [%/(mm/s)], 刹车关键
   Deadband   : Real;   // 到位死区 [mm]
   OutMax     : Real;   // 输出上限 [%], 默认 100
   Cycle      : Real;   // 采样周期 [s], 必须等于所在 OB 周期
END_VAR

VAR_OUTPUT
   Output     : Real;   // 阀开度指令 [0~100%] -> 接你已做好的电压输出程序
   InPosition : Bool;   // 到位标志(误差已进死区)
   ErrNow     : Real;   // 当前误差 [mm] (诊断)
END_VAR

VAR
   Integ      : Real;   // 积分累加项(已含 Kp*Cycle/Ti 系数)
END_VAR

VAR_TEMP
   Err        : Real;   // 位置误差
   P_Term     : Real;   // 比例项
   I_Term     : Real;   // 积分项
   D_Term     : Real;   // 阻尼项(刹车)
   Out_Raw    : Real;   // 求和未限幅值
END_VAR

BEGIN

//---------------------------------------------------------------------------
// REGION 1  使能 / 复位门控 —— 失能立即停, 清积分
//---------------------------------------------------------------------------
IF (NOT #Enable) OR #Reset THEN
    #Integ      := 0.0;
    #Output     := 0.0;
    #InPosition := FALSE;
    #ErrNow     := 0.0;
    RETURN;
END_IF;

//---------------------------------------------------------------------------
// REGION 2  误差
//---------------------------------------------------------------------------
#Err    := #Setpoint - #Actual;
#ErrNow := #Err;

//---------------------------------------------------------------------------
// REGION 3  到位判断 —— 误差进死区 -> 停, 清积分
//   (单方向: Err<=Deadband 即到位; 若冲过头 Err<0 也算到位, 只能停)
//---------------------------------------------------------------------------
IF #Err <= #Deadband THEN
    #InPosition := TRUE;
    #Output     := 0.0;
    #Integ      := 0.0;
    RETURN;
END_IF;
#InPosition := FALSE;

//---------------------------------------------------------------------------
// REGION 4  比例项
//---------------------------------------------------------------------------
#P_Term := #Kp * #Err;

//---------------------------------------------------------------------------
// REGION 5  积分项(抗饱和 clamping: 输出越上限且误差仍正 -> 冻结)
//   单方向定位, 积分只累加正向; 到位/过头已在上方清掉
//---------------------------------------------------------------------------
IF #Ti > 0.0 THEN
    #I_Term := #Integ + (#Kp * #Cycle / #Ti) * #Err;
    // 抗饱和: 总输出将超上限且误差仍正 -> 冻结积分(回退本次累加)
    IF (#P_Term + #I_Term + (-#VelDamp * #Velocity)) > #OutMax AND #Err > 0.0 THEN
        #I_Term := #Integ;
    END_IF;
    #Integ := #I_Term;
ELSE
    #I_Term := 0.0;
    #Integ := 0.0;
END_IF;

//---------------------------------------------------------------------------
// REGION 6  阻尼项(刹车) —— 负号! 速度越快反向拉劲越大
//   解决"开度减小了但速度降不下来"的核心项
//---------------------------------------------------------------------------
#D_Term := -#VelDamp * #Velocity;

//---------------------------------------------------------------------------
// REGION 7  求和 + 单方向限幅 [0, OutMax]
//   下限固定 0: 单方向, 不产生反向输出
//---------------------------------------------------------------------------
#Out_Raw := #P_Term + #I_Term + #D_Term;

IF #Out_Raw > #OutMax THEN
    #Output := #OutMax;
ELSIF #Out_Raw < 0.0 THEN
    #Output := 0.0;
ELSE
    #Output := #Out_Raw;
END_IF;

END_FUNCTION_BLOCK
