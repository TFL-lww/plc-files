//============================================================================
// FB "FB_Position_Trap" —— 油缸单方向位置定位(梯形速度曲线)
// 平台: SIMATIC S7-1200 / TIA Portal (SCL)   VERSION 1.0
//
// 【用途】油缸从当前位置推进到目标位置, 到达后停止。只做单方向(推进)。
//
// 【与"P+阻尼"的区别】本块不做"误差越大开度越大"的指数渐近(那样越到
//   后面越磨), 而是用运动学"梯形速度曲线":
//     满速段: 以 Vmax 匀速推进(开度由速度环维持)
//     减速段: 距目标 <= Vmax^2/(2a) 时, 按固定减速度 a 线性减速
//     到位瞬间速度正好归零, 干净停住
//   结果: 定位更快, 且末端不"磨蹭"。
//
// 【速度环】目标速度 Vref 由距离规划得出, 再用
//     开度% = (Vref/Vmax)*100  (前馈)
//           + Kv*(Vref - Velocity)  (速度环修正, 补偿惯性/负载)
//   其中 Velocity 是你已做好的速度采集(mm/s), Kv 单位 %/(mm/s)。
//
// 【单方向要点】输出下限 = 0(不反向推)。目标位置必须 >= 当前实际位置。
//
// 【调用位置】循环中断 OB(如 OB35, 10ms), Cycle 填该 OB 实际周期
//============================================================================
FUNCTION_BLOCK "FB_Position_Trap"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0

VAR_INPUT
   Enable     : Bool;   // 使能; FALSE -> 输出 0
   Reset      : Bool;   // 复位
   Setpoint   : Real;   // 目标位置 [mm]
   Actual     : Real;   // 当前位置 [mm] (你已做好的位移采集)
   Velocity   : Real;   // 当前速度 [mm/s] (你已做好的速度采集)
   Vmax       : Real;   // 最大速度 [mm/s], 默认 140
   Accel      : Real;   // 减速度 [mm/s^2], 默认 200 (实测可调)
   Kv         : Real;   // 速度环增益 [%/(mm/s)], 默认 2.0
   Deadband   : Real;   // 到位死区 [mm], 默认 1.0
   Cycle      : Real;   // 采样周期 [s], 必须等于所在 OB 周期
END_VAR

VAR_OUTPUT
   Output     : Real;   // 阀开度指令 [0~100%] -> 接你已做好的电压输出
   InPosition : Bool;   // 到位标志
   VrefNow    : Real;   // 当前目标速度 [mm/s] (诊断)
   ErrNow     : Real;   // 当前误差 [mm] (诊断)
END_VAR

VAR
   PrevErr    : Real;   // 上周期误差(诊断/备用)
END_VAR

VAR_TEMP
   Err        : Real;   // 位置误差
   DecDist    : Real;   // 减速距离 = Vmax^2/(2a)
   Vref       : Real;   // 目标速度(规划值)
   OutFF      : Real;   // 速度前馈项
   OutCorr    : Real;   // 速度环修正项
   Out_Raw    : Real;   // 求和未限幅值
END_VAR

BEGIN

//---------------------------------------------------------------------------
// REGION 1  使能 / 复位门控
//---------------------------------------------------------------------------
IF (NOT #Enable) OR #Reset THEN
    #Output     := 0.0;
    #InPosition := FALSE;
    #VrefNow    := 0.0;
    #ErrNow     := 0.0;
    #PrevErr    := 0.0;
    RETURN;
END_IF;

//---------------------------------------------------------------------------
// REGION 2  误差(单方向, 只推进)
//---------------------------------------------------------------------------
#Err    := #Setpoint - #Actual;
#ErrNow := #Err;

//---------------------------------------------------------------------------
// REGION 3  到位判断 —— 误差进死区 -> 停
//---------------------------------------------------------------------------
IF #Err <= #Deadband THEN
    #InPosition := TRUE;
    #Output     := 0.0;
    #VrefNow    := 0.0;
    RETURN;
END_IF;
#InPosition := FALSE;

//---------------------------------------------------------------------------
// REGION 4  梯形速度规划 —— 由剩余距离生成目标速度 Vref
//   减速距离 DecDist = Vmax^2 / (2*Accel)
//   剩余距离 > DecDist  -> 满速 Vmax
//   剩余距离 <= DecDist -> 按 sqrt(2*Accel*Err) 线性减速到 0
//---------------------------------------------------------------------------
IF #Accel > 0.0 THEN
    #DecDist := (#Vmax * #Vmax) / (2.0 * #Accel);
ELSE
    #DecDist := 0.0;    // 保护: Accel<=0 时不做减速规划
END_IF;

IF #Err > #DecDist THEN
    #Vref := #Vmax;                       // 满速段
ELSE
    // 减速段: v = sqrt(2*a*e), 到位瞬间 e->0 则 v->0
    #Vref := SQRT(2.0 * #Accel * #Err);
    IF #Vref > #Vmax THEN
        #Vref := #Vmax;
    END_IF;
END_IF;
#VrefNow := #Vref;

//---------------------------------------------------------------------------
// REGION 5  速度环: 前馈 + 修正, 生成阀开度 [0~100%]
//   前馈: Vref/Vmax*100        (100% = Vmax = 满开)
//   修正: Kv*(Vref - Velocity) (实际速度追目标速度, 补偿惯性/负载)
//---------------------------------------------------------------------------
#OutFF   := (#Vref / #Vmax) * 100.0;
#OutCorr := #Kv * (#Vref - #Velocity);

#Out_Raw := #OutFF + #OutCorr;

//---------------------------------------------------------------------------
// REGION 6  单方向限幅 [0, 100]
//---------------------------------------------------------------------------
IF #Out_Raw > 100.0 THEN
    #Output := 100.0;
ELSIF #Out_Raw < 0.0 THEN
    #Output := 0.0;
ELSE
    #Output := #Out_Raw;
END_IF;

//---------------------------------------------------------------------------
// REGION 7  保存历史
//---------------------------------------------------------------------------
#PrevErr := #Err;

END_FUNCTION_BLOCK
